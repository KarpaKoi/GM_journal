#include <windows.h>

1 ICON "gmjournal.ico"
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_NUMS
 PRODUCTVERSION APP_VERSION_NUMS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041004B0"
    BEGIN
      VALUE "ProductName", "GM Journal"
      VALUE "FileDescription", "GM Journal"
      VALUE "FileVersion", APP_VERSION_TEXT
      VALUE "ProductVersion", APP_VERSION_TEXT
      VALUE "OriginalFilename", "GMJournal.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0410, 0x04B0
  END
END
